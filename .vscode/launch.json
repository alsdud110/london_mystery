{
  // London Mystery: one app on Android and iOS,
  //   com.londonmystery.app ("London Mystery").
  // Pick the device in the status bar (an Android emulator or an iOS
  // simulator such as iPhone 17 Pro). An Android release build needs the
  // upload key (android/key.properties, see android/app/build.gradle.kts).
  "version": "0.2.0",
  "configurations": [
    {
      "name": "London Mystery (debug)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "flutterMode": "debug"
    },
    {
      "name": "London Mystery (profile)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "flutterMode": "profile"
    },
    {
      "name": "London Mystery (release, no operator tools)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "flutterMode": "release"
    }
  ]
}
