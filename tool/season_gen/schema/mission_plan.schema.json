{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://world-mystery.invalid/season_gen/schema/mission_plan.schema.json",
  "title": "MissionPlan",
  "description": "One mission or final, planned (inside a CasePlan, whose schemaVersion it shares). Unknown fields are rejected. Whether its clue inputs exist and are found before it is the clue graph's (STEP 3-4).",
  "type": "object",
  "additionalProperties": false,
  "required": ["missionId", "slot", "placeId", "puzzle", "clueInputs", "clueOutputs", "learning"],
  "properties": {
    "missionId": { "$ref": "common.schema.json#/$defs/missionId" },
    "slot": { "$ref": "common.schema.json#/$defs/slot" },
    "placeId": { "$ref": "common.schema.json#/$defs/placeId" },
    "puzzle": { "$ref": "puzzle_plan.schema.json" },
    "clueInputs": { "type": "array", "items": { "$ref": "#/$defs/clueInput" } },
    "clueOutputs": { "$ref": "#/$defs/clueOutputs" },
    "learning": { "$ref": "#/$defs/learning" },
    "play": { "$ref": "#/$defs/play" },
    "notes": { "$ref": "common.schema.json#/$defs/lines" }
  },
  "$defs": {
    "play": {
      "description": "The mission's words as the game's Mission JSON has them (its keys). Every field is optional while planned; PlayCheck asks for what the game needs.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": { "$ref": "common.schema.json#/$defs/text" },
        "location": { "$ref": "common.schema.json#/$defs/text" },
        "story": { "$ref": "common.schema.json#/$defs/lines" },
        "letterIntro": { "$ref": "common.schema.json#/$defs/text" },
        "letter": { "$ref": "common.schema.json#/$defs/text" },
        "question": { "$ref": "common.schema.json#/$defs/text" },
        "prompt": { "$ref": "common.schema.json#/$defs/text" },
        "hints": { "$ref": "common.schema.json#/$defs/lines" },
        "successMessage": { "$ref": "common.schema.json#/$defs/text" },
        "transition": { "$ref": "common.schema.json#/$defs/lines" },
        "feedback": { "$ref": "common.schema.json#/$defs/textMap" },
        "orderFeedback": { "$ref": "common.schema.json#/$defs/text" },
        "mapX": { "$ref": "common.schema.json#/$defs/fraction" },
        "mapY": { "$ref": "common.schema.json#/$defs/fraction" },
        "clue": { "$ref": "#/$defs/clueText" },
        "evidence": { "$ref": "#/$defs/evidenceText" },
        "recall": { "$ref": "#/$defs/recallText" },
        "evidenceLinkLine": { "$ref": "common.schema.json#/$defs/text" },
        "lockTitle": { "$ref": "common.schema.json#/$defs/text" },
        "hideOptionNames": { "type": "boolean" },
        "explore": { "$ref": "#/$defs/explore" },
        "search": { "$ref": "#/$defs/search" },
        "dialogue": { "$ref": "#/$defs/dialogue" },
        "talk": { "$ref": "#/$defs/talk" },
        "discovery": { "$ref": "#/$defs/discovery" },
        "ending": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/endingLine" } }
      }
    },
    "talk": {
      "description": "Short talks around a mission's puzzle with one person of the case (TalkMission, table talkMissions; STEP 3-13B): before it (what to look into; then the letter or the puzzle as without it) and/or after it (their reaction to what was found, before the Discovery Moment). Missions only.",
      "type": "object",
      "additionalProperties": false,
      "required": ["speaker", "goal"],
      "properties": {
        "speaker": { "$ref": "common.schema.json#/$defs/localId" },
        "portrait": { "$ref": "common.schema.json#/$defs/assetFile" },
        "goal": { "$ref": "common.schema.json#/$defs/text" },
        "before": { "$ref": "#/$defs/talkPart" },
        "after": { "$ref": "#/$defs/talkPart" }
      }
    },
    "talkPart": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lines"],
      "properties": {
        "lines": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/talkLine" } },
        "finishLabel": { "$ref": "common.schema.json#/$defs/text" }
      }
    },
    "talkLine": {
      "description": "One short line: said by the talk's speaker, the detective (YOU) or the narrator.",
      "type": "object",
      "additionalProperties": false,
      "required": ["by", "text"],
      "properties": {
        "by": { "type": "string", "enum": ["speaker", "detective", "narrator"] },
        "text": { "$ref": "common.schema.json#/$defs/text" }
      }
    },
    "discovery": {
      "description": "The mission's own Discovery Moment (Discovery, table discoveries): what was found (title), why it matters and where it leads (detail). Missions only; without it, the moment shows the success line.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "title", "detail"],
      "properties": {
        "type": { "type": "string", "enum": ["evidenceFound", "clueFound", "clueConfirmed", "deduction", "newLead", "storyDiscovery"] },
        "timing": { "type": "string", "enum": ["beforePuzzle", "fromPuzzle", "afterPuzzle"] },
        "title": { "$ref": "common.schema.json#/$defs/text" },
        "detail": { "$ref": "common.schema.json#/$defs/text" },
        "note": { "$ref": "common.schema.json#/$defs/text" },
        "showEvidence": { "type": "boolean" },
        "seasonClue": { "type": "boolean" }
      }
    },
    "endingLine": {
      "description": "One line of a final's ending, after its answer (EndingLine, table endings): the case closes once it is seen. A speaker's line names the person (a charId of the case).",
      "type": "object",
      "additionalProperties": false,
      "required": ["by", "text"],
      "properties": {
        "by": { "type": "string", "enum": ["speaker", "detective", "narrator"] },
        "text": { "$ref": "common.schema.json#/$defs/text" },
        "speaker": { "$ref": "common.schema.json#/$defs/localId" },
        "portrait": { "$ref": "common.schema.json#/$defs/assetFile" },
        "evidence": { "$ref": "common.schema.json#/$defs/evidenceId" }
      }
    },
    "point": {
      "description": "A point on a picture, [x, y] in its pixels.",
      "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" }
    },
    "rect": {
      "description": "A rectangle on a picture, [left, top, right, bottom] in its pixels.",
      "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "number" }
    },
    "rects": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/rect" } },
    "pixels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "picture": {
      "description": "A picture file and its size in pixels; measuredOn: the file's hash when the places on it were measured (STEP 3-15A).",
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "pixels"],
      "properties": {
        "file": { "$ref": "common.schema.json#/$defs/assetFile" },
        "pixels": { "$ref": "#/$defs/pixels" },
        "measuredOn": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "emptySpot": {
      "description": "A place on a picture that holds nothing (InvestigationSpot).",
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "areas", "line"],
      "properties": {
        "label": { "$ref": "common.schema.json#/$defs/text" },
        "areas": { "$ref": "#/$defs/rects" },
        "line": { "$ref": "common.schema.json#/$defs/text" }
      }
    },
    "explore": {
      "description": "A look round the place (ExploreScene, table explores).",
      "type": "object",
      "additionalProperties": false,
      "required": ["picture", "place", "task", "nextTask", "missLine", "guideAt", "spots", "choiceTitle", "choiceHow", "choicePixels", "choices"],
      "properties": {
        "picture": { "$ref": "#/$defs/picture" },
        "place": { "$ref": "common.schema.json#/$defs/text" },
        "task": { "$ref": "common.schema.json#/$defs/text" },
        "nextTask": { "$ref": "common.schema.json#/$defs/text" },
        "missLine": { "$ref": "common.schema.json#/$defs/text" },
        "guideAt": { "$ref": "#/$defs/point" },
        "spots": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/exploreSpot" } },
        "others": { "type": "array", "items": { "$ref": "#/$defs/emptySpot" } },
        "choiceTitle": { "$ref": "common.schema.json#/$defs/text" },
        "choiceHow": { "$ref": "common.schema.json#/$defs/text" },
        "choicePixels": { "$ref": "#/$defs/pixels" },
        "choices": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/exploreChoice" } },
        "inside": { "$ref": "#/$defs/rect" },
        "opening": { "$ref": "#/$defs/rect" },
        "documentLabel": { "$ref": "common.schema.json#/$defs/text" }
      }
    },
    "exploreSpot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "title", "label", "areas", "mark"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/localId" },
        "kind": { "type": "string", "enum": ["document", "note", "choice"] },
        "title": { "$ref": "common.schema.json#/$defs/text" },
        "label": { "$ref": "common.schema.json#/$defs/text" },
        "areas": { "$ref": "#/$defs/rects" },
        "mark": { "$ref": "#/$defs/point" },
        "line": { "$ref": "common.schema.json#/$defs/text" },
        "requires": { "$ref": "common.schema.json#/$defs/localId" },
        "lockedLine": { "$ref": "common.schema.json#/$defs/text" },
        "unreadLine": { "$ref": "common.schema.json#/$defs/text" }
      }
    },
    "exploreChoice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["optionId", "picture", "description"],
      "properties": {
        "optionId": { "$ref": "common.schema.json#/$defs/text" },
        "picture": { "$ref": "common.schema.json#/$defs/assetFile" },
        "description": { "$ref": "common.schema.json#/$defs/text" }
      }
    },
    "search": {
      "description": "A search of the place for what the letter lists (InvestigationScene, table investigations).",
      "type": "object",
      "additionalProperties": false,
      "required": ["picture", "task", "documentTitle", "missLine", "doneLine", "arrival", "guideAt", "finds"],
      "properties": {
        "picture": { "$ref": "#/$defs/picture" },
        "task": { "$ref": "common.schema.json#/$defs/text" },
        "documentTitle": { "$ref": "common.schema.json#/$defs/text" },
        "missLine": { "$ref": "common.schema.json#/$defs/text" },
        "doneLine": { "$ref": "common.schema.json#/$defs/text" },
        "arrival": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/text" } },
        "guideAt": { "$ref": "#/$defs/point" },
        "finds": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/searchFind" } },
        "spots": { "type": "array", "items": { "$ref": "#/$defs/emptySpot" } },
        "opening": { "$ref": "#/$defs/rect" },
        "inside": { "$ref": "#/$defs/rect" },
        "startLabel": { "$ref": "common.schema.json#/$defs/text" },
        "documentLabel": { "$ref": "common.schema.json#/$defs/text" }
      }
    },
    "searchFind": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "title", "reportLine", "spot", "areas", "foundLine", "picture", "at", "width"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/localId" },
        "name": { "$ref": "common.schema.json#/$defs/text" },
        "title": { "$ref": "common.schema.json#/$defs/text" },
        "reportLine": { "$ref": "common.schema.json#/$defs/text" },
        "spot": { "$ref": "common.schema.json#/$defs/text" },
        "areas": { "$ref": "#/$defs/rects" },
        "foundLine": { "$ref": "common.schema.json#/$defs/text" },
        "picture": { "$ref": "#/$defs/picture" },
        "at": { "$ref": "#/$defs/point" },
        "width": { "type": "number", "minimum": 1 },
        "squash": { "type": "number", "minimum": 0.1, "maximum": 1 },
        "turn": { "type": "number", "minimum": -3.2, "maximum": 3.2 }
      }
    },
    "dialogue": {
      "description": "A talk with the witnesses (DialogueScene, table dialogues). A statement is an answer with a thing; its id is <witness>.<question>.",
      "type": "object",
      "additionalProperties": false,
      "required": ["place", "background", "goal", "how", "guide", "questions", "witnesses", "deduction"],
      "properties": {
        "place": { "$ref": "common.schema.json#/$defs/text" },
        "background": { "$ref": "common.schema.json#/$defs/assetFile" },
        "goal": { "$ref": "common.schema.json#/$defs/text" },
        "how": { "$ref": "common.schema.json#/$defs/text" },
        "guide": { "$ref": "common.schema.json#/$defs/text" },
        "questions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/talkQuestion" } },
        "witnesses": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/talkWitness" } },
        "deduction": { "$ref": "#/$defs/talkDeduction" }
      }
    },
    "talkQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/localId" },
        "text": { "$ref": "common.schema.json#/$defs/text" }
      }
    },
    "talkWitness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "title", "portrait", "description", "greeting", "answers"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/localId" },
        "name": { "$ref": "common.schema.json#/$defs/text" },
        "title": { "$ref": "common.schema.json#/$defs/text" },
        "portrait": { "$ref": "common.schema.json#/$defs/assetFile" },
        "description": { "$ref": "common.schema.json#/$defs/text" },
        "greeting": { "$ref": "common.schema.json#/$defs/text" },
        "answers": { "type": "object", "additionalProperties": { "$ref": "#/$defs/talkAnswer" } },
        "face": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y"],
          "properties": {
            "x": { "$ref": "common.schema.json#/$defs/fraction" },
            "y": { "$ref": "common.schema.json#/$defs/fraction" }
          }
        }
      }
    },
    "talkAnswer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["line"],
      "properties": {
        "line": { "$ref": "common.schema.json#/$defs/text" },
        "thing": { "$ref": "common.schema.json#/$defs/text" }
      }
    },
    "talkDeduction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["topic", "pair", "askLine", "anotherLine", "readyLine", "compareGoal", "compareHow", "matchLine", "offTopicLine", "checkLine", "differentLine", "retryLine"],
      "properties": {
        "topic": { "$ref": "common.schema.json#/$defs/localId" },
        "pair": { "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/text" } },
        "then": { "type": "array", "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/text" } },
        "witnesses": { "type": "integer", "minimum": 1 },
        "askLine": { "$ref": "common.schema.json#/$defs/text" },
        "anotherLine": { "$ref": "common.schema.json#/$defs/text" },
        "readyLine": { "$ref": "common.schema.json#/$defs/text" },
        "compareGoal": { "$ref": "common.schema.json#/$defs/text" },
        "compareHow": { "$ref": "common.schema.json#/$defs/text" },
        "matchLine": { "$ref": "common.schema.json#/$defs/text" },
        "offTopicLine": { "$ref": "common.schema.json#/$defs/text" },
        "checkLine": { "$ref": "common.schema.json#/$defs/text" },
        "differentLine": { "$ref": "common.schema.json#/$defs/text" },
        "retryLine": { "$ref": "common.schema.json#/$defs/text" },
        "thenGoal": { "$ref": "common.schema.json#/$defs/text" },
        "thenHow": { "$ref": "common.schema.json#/$defs/text" },
        "doneLine": { "$ref": "common.schema.json#/$defs/text" },
        "notesLine": { "$ref": "common.schema.json#/$defs/text" }
      }
    },
    "clueText": {
      "description": "The game's Clue, its id the mission's clueOutputs.clue.",
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "value", "note"],
      "properties": {
        "title": { "$ref": "common.schema.json#/$defs/text" },
        "value": { "$ref": "common.schema.json#/$defs/text" },
        "note": { "$ref": "common.schema.json#/$defs/text" },
        "symbol": { "$ref": "common.schema.json#/$defs/text" }
      }
    },
    "evidenceText": {
      "description": "The game's Evidence, its id the mission's clueOutputs.evidence.",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "icon", "description"],
      "properties": {
        "name": { "$ref": "common.schema.json#/$defs/text" },
        "icon": { "$ref": "common.schema.json#/$defs/text" },
        "description": { "$ref": "common.schema.json#/$defs/text" },
        "inscription": { "$ref": "common.schema.json#/$defs/text" },
        "symbols": { "$ref": "common.schema.json#/$defs/lines" }
      }
    },
    "recallText": {
      "description": "The game's EvidenceRecall words, its evidence the mission's recall clue input.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": { "$ref": "common.schema.json#/$defs/text" },
        "prompt": { "$ref": "common.schema.json#/$defs/text" },
        "feedback": { "$ref": "common.schema.json#/$defs/textMap" },
        "miss": { "$ref": "common.schema.json#/$defs/text" }
      }
    },
    "clueInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "use"],
      "properties": {
        "ref": { "$ref": "common.schema.json#/$defs/clueRef" },
        "use": { "type": "string", "enum": ["answerDerivation", "talkPresent", "evidenceLink", "recall", "learningRecall", "textMention"] },
        "note": { "$ref": "common.schema.json#/$defs/text" }
      }
    },
    "clueOutputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence"],
      "properties": {
        "clue": { "$ref": "common.schema.json#/$defs/clueId" },
        "evidence": { "$ref": "common.schema.json#/$defs/evidenceId" },
        "facts": { "type": "array", "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/factId" } }
      }
    },
    "learning": {
      "description": "The game's LearningObjective, its enums by name.",
      "type": "object",
      "additionalProperties": false,
      "required": ["dependency", "level", "objective"],
      "properties": {
        "dependency": { "type": "string", "enum": ["essential", "helpful", "exposure", "low"] },
        "level": { "type": "string", "enum": ["exposure", "comprehension", "application", "recall"] },
        "objective": { "$ref": "common.schema.json#/$defs/text" },
        "skill": { "type": "string", "enum": ["vocabulary", "sentenceMeaning", "grammarInContext"] },
        "expressions": { "$ref": "common.schema.json#/$defs/lines" },
        "recallFrom": { "$ref": "common.schema.json#/$defs/missionId" }
      }
    }
  }
}
