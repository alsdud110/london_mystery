{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://world-mystery.invalid/season_gen/schema/common.schema.json",
  "title": "Season plan common definitions",
  "description": "Ids and text shared by the season content pipeline's plans (schema version 1). The patterns are those of tool/season_gen/plan_ids.dart, word for word.",
  "$defs": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "text": { "type": "string", "minLength": 1 },
    "lines": { "type": "array", "items": { "$ref": "#/$defs/text" } },
    "textMap": { "type": "object", "additionalProperties": { "$ref": "#/$defs/text" } },
    "fraction": { "type": "number", "minimum": 0, "maximum": 1 },
    "assetFile": { "type": "string", "pattern": "^assets/([A-Za-z0-9_-]+/)*[A-Za-z0-9_-]+\\.(png|jpg|jpeg|webp)$" },
    "seasonId": { "type": "string", "pattern": "^s([1-9][0-9]*)_[a-z][a-z0-9]*$" },
    "caseId": { "type": "string", "pattern": "^s([1-9][0-9]*)_ep([0-9]{2})$" },
    "missionId": { "type": "string", "pattern": "^s[1-9][0-9]*_ep[0-9]{2}_(m[1-9]|final)$" },
    "slot": { "type": "string", "pattern": "^(m[1-9]|final)$" },
    "clueId": { "type": "string", "pattern": "^s[1-9][0-9]*_ep[0-9]{2}_c[1-9][0-9]*$" },
    "evidenceId": { "type": "string", "pattern": "^s[1-9][0-9]*_ep[0-9]{2}_e[1-9][0-9]*$" },
    "factId": { "type": "string", "pattern": "^s[1-9][0-9]*_ep[0-9]{2}_f[1-9][0-9]*$" },
    "clueRef": { "type": "string", "pattern": "^s[1-9][0-9]*_ep[0-9]{2}_[cef][1-9][0-9]*$" },
    "placeId": { "type": "string", "pattern": "^s[1-9][0-9]*_[a-z][a-z0-9]*\\.[a-z][a-z0-9_]*$" },
    "assetId": { "type": "string", "pattern": "^s[1-9][0-9]*_[a-z][a-z0-9]*\\.asset\\.[a-z][a-z0-9_]*$" },
    "localId": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "actId": { "type": "string", "pattern": "^act[1-3]$" },
    "landmarkKey": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
    "paletteId": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "engineTable": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" }
  }
}
