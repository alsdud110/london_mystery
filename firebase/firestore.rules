rules_version = '2';

// London Mystery — Firestore rules (Phase 3A-3, Phase 4.1 sync paths).
// See docs/PHASE3A_FIREBASE_AUTH_PLAN.md §13, docs/PHASE4_CLOUD_SYNC_DESIGN.md §12.
//
//   users/{uid}                        the account (uid = Firebase Auth uid)
//   users/{uid}/profiles/{profileId}   its detective profiles
//     sync/meta                        the reset generation (epoch), increases only
//     cases/{caseId}                   a case's progress at the current epoch
//     season/state                     the season at the current epoch
//     wallet/{epoch}_{key}             coin events: create only
//     wallet/summary                   the running balance (never below 0)
//   consents/{uid}                     the account's privacy consent record
//   deletions/{uid}                    an account deletion in progress (server only)
//
// - The path is the ownership: only the signed-in user {uid} reaches it.
// - consents/{uid} is written only by a trusted backend (Admin SDK, which
//   these rules do not apply to). The client may read its own record and
//   nothing else; it can never create, change or delete one.
// - Without a confirmed consent record, the account writes nothing to the
//   cloud, its users document included.
// - While an account deletion exists (deletions/{uid}), nothing is written.
// - Sync documents: cloudVersion starts at 1 and goes up by exactly 1 per
//   write; their epoch must equal the server's sync/meta epoch (read after
//   the write, so a reset and its first write can go together).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // The trusted consent record says 'confirmed'. Read from the stored
    // record (never from the request), so a client cannot vouch for itself.
    function consentConfirmed(uid) {
      let record = /databases/$(database)/documents/consents/$(uid);
      return exists(record) && get(record).data.get('status', '') == 'confirmed';
    }

    // An account deletion has started (written by the server only).
    function deleting(uid) {
      return exists(/databases/$(database)/documents/deletions/$(uid));
    }

    function canWrite(uid) {
      return isOwner(uid) && consentConfirmed(uid) && !deleting(uid);
    }

    function hasExactly(keys) {
      return request.resource.data.keys().hasAll(keys) && request.resource.data.keys().hasOnly(keys);
    }

    function changesOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // The detective name rule (lib/data/models/detective_name.dart, same
    // pattern): letters, Hangul syllables, digits, single inner spaces, "."
    // and "-"; 1 to 12 characters (size() counts UTF-16 units, as Dart).
    function validName(n) {
      return n is string && n.size() >= 1 && n.size() <= 12
        && n.matches('^[A-Za-z0-9가-힣.-]([A-Za-z0-9가-힣 .-]*[A-Za-z0-9가-힣.-])?$')
        && !n.matches('.*  .*');
    }

    // A profile document id is the local profile id (lib/data/models/profile.dart).
    function validProfileId(id) {
      return id.matches('^[0-9a-f]{8,64}$');
    }

    // ---- Phase 4.1: sync documents under a profile ----

    // The shipped season (GENERATED from the bundled catalog; the Dart test
    // test/cloud_profile_store_test.dart fails if they ever differ).
    function missionCoins() {
      return {'m01': 30, 'm02': 30, 'm03': 30, 'm04': 30, 'm05': 30, 'final': 60, 'ep02_m1': 30, 'ep02_m2': 30, 'ep02_m3': 30, 'ep02_final': 60, 'ep03_m1': 30, 'ep03_m2': 30, 'ep03_m3': 30, 'ep03_final': 60, 'ep04_m1': 30, 'ep04_m2': 30, 'ep04_m3': 30, 'ep04_final': 60, 'ep05_m1': 30, 'ep05_m2': 30, 'ep05_m3': 30, 'ep05_final': 60, 'ep06_m1': 30, 'ep06_m2': 30, 'ep06_m3': 30, 'ep06_final': 60, 'ep07_m1': 30, 'ep07_m2': 30, 'ep07_m3': 30, 'ep07_final': 60, 'ep08_m1': 30, 'ep08_m2': 30, 'ep08_m3': 30, 'ep08_final': 60, 'ep09_m1': 30, 'ep09_m2': 30, 'ep09_m3': 30, 'ep09_final': 60, 'ep10_m1': 30, 'ep10_m2': 30, 'ep10_m3': 30, 'ep10_final': 60, 'ep11_m1': 30, 'ep11_m2': 30, 'ep11_m3': 30, 'ep11_final': 60, 'ep12_m1': 30, 'ep12_m2': 30, 'ep12_m3': 30, 'ep12_final': 60};
    }

    function episodeIds() {
      return ['ep01', 'ep02', 'ep03', 'ep04', 'ep05', 'ep06', 'ep07', 'ep08', 'ep09', 'ep10', 'ep11', 'ep12'];
    }

    function caseMissions() {
      return {'ep01': ['m01', 'm02', 'm03', 'm04', 'm05', 'final'], 'ep02': ['ep02_m1', 'ep02_m2', 'ep02_m3', 'ep02_final'], 'ep03': ['ep03_m1', 'ep03_m2', 'ep03_m3', 'ep03_final'], 'ep04': ['ep04_m1', 'ep04_m2', 'ep04_m3', 'ep04_final'], 'ep05': ['ep05_m1', 'ep05_m2', 'ep05_m3', 'ep05_final'], 'ep06': ['ep06_m1', 'ep06_m2', 'ep06_m3', 'ep06_final'], 'ep07': ['ep07_m1', 'ep07_m2', 'ep07_m3', 'ep07_final'], 'ep08': ['ep08_m1', 'ep08_m2', 'ep08_m3', 'ep08_final'], 'ep09': ['ep09_m1', 'ep09_m2', 'ep09_m3', 'ep09_final'], 'ep10': ['ep10_m1', 'ep10_m2', 'ep10_m3', 'ep10_final'], 'ep11': ['ep11_m1', 'ep11_m2', 'ep11_m3', 'ep11_final'], 'ep12': ['ep12_m1', 'ep12_m2', 'ep12_m3', 'ep12_final']};
    }

    function missionIds() {
      return missionCoins().keys();
    }

    function optBool(v) {
      return v == null || v is bool;
    }

    function optCount(v) {
      return v == null || isCount(v);
    }

    function optText(v, n) {
      return v == null || (v is string && v.size() <= n);
    }

    function optList(v, n) {
      return v == null || (v is list && v.size() <= n);
    }

    // A per-mission map (attempts, hints, …): only this case's missions as keys.
    function optMissionMap(v, ms) {
      return v == null || (v is map && v.keys().hasOnly(ms));
    }

    // A case's progress: the fields the game saves, their shapes, this case's
    // missions only. Values inside maps and lists are not typed one by one
    // (Rules cannot); sizes are bounded.
    // [ms]: this case's mission ids (built once: Rules count every expression).
    function progressOk(p, ms) {
      return p.keys().hasOnly(['detectiveName', 'introSeen', 'completedMissionIds', 'attempts',
          'wrongAnswers', 'hintsUsed', 'missionStartedAt', 'missionStartPlayMillis', 'solveSeconds',
          'badgeIds', 'lookedUpWords', 'lookupsRecorded', 'xpRules', 'behavior', 'startedAt',
          'completedAt', 'playMillis', 'runId', 'runSeq', 'rev'])
        && optText(p.get('detectiveName', null), 24)
        && optBool(p.get('introSeen', null))
        && optBool(p.get('lookupsRecorded', null))
        && (p.get('completedMissionIds', null) == null
            || (p.completedMissionIds is list && p.completedMissionIds.hasOnly(ms)
                && p.completedMissionIds.size() <= ms.size()))
        && optMissionMap(p.get('attempts', null), ms)
        && optMissionMap(p.get('wrongAnswers', null), ms)
        && optMissionMap(p.get('hintsUsed', null), ms)
        && optMissionMap(p.get('missionStartedAt', null), ms)
        && optMissionMap(p.get('missionStartPlayMillis', null), ms)
        && optMissionMap(p.get('solveSeconds', null), ms)
        && optMissionMap(p.get('xpRules', null), ms)
        && optList(p.get('badgeIds', null), 32)
        && optList(p.get('lookedUpWords', null), 300)
        && (p.get('behavior', null) == null
            || (p.behavior is map && p.behavior.keys().hasOnly(['rechecked', 'evidenceViewed', 'words'])
                && optList(p.behavior.get('rechecked', null), 32)
                && optList(p.behavior.get('evidenceViewed', null), 64)
                && optList(p.behavior.get('words', null), 300)))
        && optText(p.get('startedAt', null), 40)
        && optText(p.get('completedAt', null), 40)
        && optCount(p.get('playMillis', null))
        && optText(p.get('runId', null), 64)
        && optCount(p.get('runSeq', null))
        && optCount(p.get('rev', null));
    }

    function profileDoc(uid, pid) {
      return /databases/$(database)/documents/users/$(uid)/profiles/$(pid);
    }

    function metaDoc(uid, pid) {
      return /databases/$(database)/documents/users/$(uid)/profiles/$(pid)/sync/meta;
    }

    function walletDoc(uid, pid, id) {
      return /databases/$(database)/documents/users/$(uid)/profiles/$(pid)/wallet/$(id);
    }

    // Owner, consent, no deletion, and the profile exists.
    function canSync(uid, pid) {
      return canWrite(uid) && exists(profileDoc(uid, pid));
    }

    // The server's epoch, as it will be after this write (a reset and the
    // first write of its new epoch may share one transaction).
    function serverEpoch(uid, pid) {
      return getAfter(metaDoc(uid, pid)).data.epoch;
    }

    function isCount(n) {
      return n is int && n >= 0;
    }

    function firstVersion() {
      return request.resource.data.cloudVersion == 1;
    }

    function nextVersion() {
      return request.resource.data.cloudVersion == resource.data.cloudVersion + 1;
    }

    function caseFields(d, caseId) {
      let ms = caseMissions()[caseId];
      return hasExactly(['epoch', 'runId', 'runSeq', 'cloudVersion', 'progress', 'updatedAt'])
        && isCount(d.epoch)
        && (d.runId == null || (d.runId is string && d.runId.size() >= 1 && d.runId.size() <= 64))
        && isCount(d.runSeq)
        && d.cloudVersion is int
        && d.progress is map
        && progressOk(d.progress, ms)                 // no 'playtest': Operator records never go up
        && d.updatedAt == request.time;
    }

    function seasonFields(d) {
      return hasExactly(['epoch', 'cloudVersion', 'solvedEpisodeIds', 'updatedAt'])
        && isCount(d.epoch)
        && d.cloudVersion is int
        && d.solvedEpisodeIds is list
        && d.solvedEpisodeIds.size() <= 12
        && d.solvedEpisodeIds.hasOnly(episodeIds())
        && d.updatedAt == request.time;
    }

    // A coin event: the economy's sources and amounts only (app_constants:
    // start 20, mission 30, final 60, tip 1 free, tip 2 20), for missions of
    // the shipped season only, at their own amount. No refunds.
    function walletEventFields(d, id) {
      return hasExactly(['epoch', 'key', 'amount', 'source', 'at'])
        && isCount(d.epoch)
        && d.key is string && d.key.size() >= 1 && d.key.size() <= 120
        && id == string(d.epoch) + '_' + d.key
        && d.amount is int
        && d.at is timestamp
        && (
          (d.source == 'start' && d.key == 'start' && d.amount == 20)
          || ((d.source == 'mission' || d.source == 'backfill')
              && d.key.matches('^mission:[A-Za-z0-9_]{1,40}$')
              && missionCoins().get(d.key.split(':')[1], -1) == d.amount
              && (d.amount == 30 || d.amount == 60))
          || (d.source == 'tip' && d.key.matches('^tip:[A-Za-z0-9_]{1,40}:1$')
              && d.key.split(':')[1] in missionIds() && d.amount == 0)
          || (d.source == 'tip' && d.key.matches('^tip:[A-Za-z0-9_]{1,40}:2$')
              && d.key.split(':')[1] in missionIds() && (d.amount == 0 || d.amount == -20))
        );
    }

    // The running balance moves by exactly one new event per write.
    function summaryFields(d) {
      return hasExactly(['epoch', 'cloudVersion', 'balance', 'lastEventId', 'updatedAt'])
        && isCount(d.epoch)
        && d.cloudVersion is int
        && d.balance is int && d.balance >= 0
        && d.lastEventId is string
        && d.updatedAt == request.time;
    }

    function validLocale(d) {
      return d.locale is string && d.locale.matches('^[a-z]{2}$')
        && d.region is string && d.region.matches('^[A-Z]{2}$');
    }

    match /consents/{uid} {
      allow get: if isOwner(uid);
      allow list: if false;
      allow create, update, delete: if false;
    }

    match /users/{uid} {
      allow get: if isOwner(uid);
      allow list: if false;
      allow create: if canWrite(uid)
        && hasExactly(['schema', 'createdAt', 'locale', 'region'])
        && request.resource.data.schema == 1
        && request.resource.data.createdAt == request.time
        && validLocale(request.resource.data);
      allow update: if canWrite(uid)
        && changesOnly(['locale', 'region'])
        && validLocale(request.resource.data);
      allow delete: if false; // account deletion: a trusted path, later

      match /profiles/{profileId} {
        allow read: if isOwner(uid);
        // existsAfter: the account doc may be made in the same batch or
        // transaction as its first profile.
        allow create: if canWrite(uid)
          && existsAfter(/databases/$(database)/documents/users/$(uid))
          && validProfileId(profileId)
          && hasExactly(['schema', 'detectiveName', 'createdAt'])
          && request.resource.data.schema == 1
          && validName(request.resource.data.detectiveName)
          && request.resource.data.createdAt == request.time;
        allow update: if canWrite(uid)
          && changesOnly(['detectiveName'])
          && validName(request.resource.data.detectiveName);
        allow delete: if false; // until the deletion policy is decided

        // ---- Phase 4.1 sync documents ----

        match /sync/{doc} {
          allow get: if isOwner(uid) && doc == 'meta';
          allow list: if false;
          // The cloud baseline is epoch 0; a device that reset before its
          // first sync steps up from there.
          allow create: if doc == 'meta' && canSync(uid, profileId)
            && hasExactly(['epoch', 'cloudVersion', 'updatedAt'])
            && request.resource.data.epoch == 0
            && firstVersion()
            && request.resource.data.updatedAt == request.time;
          // A reset: the epoch goes up by exactly one.
          allow update: if doc == 'meta' && canSync(uid, profileId)
            && hasExactly(['epoch', 'cloudVersion', 'updatedAt'])
            && request.resource.data.epoch == resource.data.epoch + 1
            && nextVersion()
            && request.resource.data.updatedAt == request.time;
          allow delete: if false;
        }

        match /cases/{caseId} {
          allow read: if isOwner(uid);
          allow create: if canSync(uid, profileId)
            && caseId in episodeIds()
            && caseFields(request.resource.data, caseId)
            && firstVersion()
            && request.resource.data.epoch == serverEpoch(uid, profileId);
          // Same epoch: never an earlier run (Play again cannot be undone).
          allow update: if canSync(uid, profileId)
            && caseFields(request.resource.data, caseId)
            && nextVersion()
            && request.resource.data.epoch == serverEpoch(uid, profileId)
            && (request.resource.data.epoch > resource.data.epoch
                || request.resource.data.runSeq >= resource.data.runSeq);
          allow delete: if false;
        }

        match /season/{doc} {
          allow get: if isOwner(uid) && doc == 'state';
          allow list: if false;
          allow create: if doc == 'state' && canSync(uid, profileId)
            && seasonFields(request.resource.data)
            && firstVersion()
            && request.resource.data.epoch == serverEpoch(uid, profileId);
          allow update: if doc == 'state' && canSync(uid, profileId)
            && seasonFields(request.resource.data)
            && nextVersion()
            && request.resource.data.epoch == serverEpoch(uid, profileId);
          allow delete: if false;
        }

        match /wallet/{id} {
          allow read: if isOwner(uid);

          // An event: created once (its id carries its epoch), never changed
          // or removed, and only together with the summary that counts it.
          allow create: if id != 'summary' && canSync(uid, profileId)
            && walletEventFields(request.resource.data, id)
            && request.resource.data.epoch == serverEpoch(uid, profileId)
            && getAfter(walletDoc(uid, profileId, 'summary')).data.lastEventId == id;

          // The summary: the first one counts one event; each update adds
          // exactly one new event of the current epoch (a new epoch starts
          // the balance again from that event). Never below zero.
          allow create: if id == 'summary' && canSync(uid, profileId)
            && summaryFields(request.resource.data)
            && firstVersion()
            && request.resource.data.epoch == serverEpoch(uid, profileId)
            && !exists(walletDoc(uid, profileId, request.resource.data.lastEventId))
            && existsAfter(walletDoc(uid, profileId, request.resource.data.lastEventId))
            && request.resource.data.balance
                 == getAfter(walletDoc(uid, profileId, request.resource.data.lastEventId)).data.amount;
          allow update: if id == 'summary' && canSync(uid, profileId)
            && summaryFields(request.resource.data)
            && nextVersion()
            && request.resource.data.epoch == serverEpoch(uid, profileId)
            && request.resource.data.epoch >= resource.data.epoch
            && !exists(walletDoc(uid, profileId, request.resource.data.lastEventId))
            && existsAfter(walletDoc(uid, profileId, request.resource.data.lastEventId))
            && request.resource.data.balance
                 == (request.resource.data.epoch == resource.data.epoch ? resource.data.balance : 0)
                    + getAfter(walletDoc(uid, profileId, request.resource.data.lastEventId)).data.amount;

          allow update, delete: if false;
        }

        // Anything else under a profile: closed.
        match /{document=**} {
          allow read, write: if false;
        }
      }
    }

    // A deletion in progress: its owner may see it (the app stops syncing
    // on every device); only the server writes it.
    match /deletions/{uid} {
      allow get: if isOwner(uid);
      allow list, create, update, delete: if false;
    }

    // Anything else: closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
